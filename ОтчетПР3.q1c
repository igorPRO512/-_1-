<?xml version="1.0" encoding="UTF-8"?>
<querylist>
	<query name="ЗаказПокупателя">
		<text>ВЫБРАТЬ
	ЗаказПокупателя.Ссылка КАК Ссылка,
	ЗаказПокупателя.Дата КАК Дата,
	ЗаказПокупателя.Заказ.Заказчик КАК Заказчик,
	СУММА(ЗаказПокупателя.Количество * ЗаказПокупателя.Цена) КАК ПолнаяСтоимость
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя,
	Справочник.Спецификация КАК Спецификация
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидТовара КАК ВидТовара
		ПО (Спецификация.Материал = ВидТовара.Ссылка)

СГРУППИРОВАТЬ ПО
	ЗаказПокупателя.Ссылка,
	ЗаказПокупателя.Дата,
	ЗаказПокупателя.Заказ.Заказчик
</text>
		<textSQL>

		</textSQL>
		<planSQL>

		</planSQL>
		<typeSQL>

		</typeSQL>
	</query>
</querylist>