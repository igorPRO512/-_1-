		<expression>Сумма(ТоварыВЗаказе.ТоварСкидка)</expression>
		<group>ОбщийИтог</group>
	</totalField>
	<totalField>
		<dataPath>ТоварыВЗаказе.ТоварСумма</dataPath>
		<expression>Сумма(ТоварыВЗаказе.ТоварСумма)</expression>
		<group>ОбщийИтог</group>
	</totalField>
