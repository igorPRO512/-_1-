		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	ЗаказПокупателя.Заказчик КАК Заказчик,
	ЗаказПокупателя.ТоварыВЗаказе.(
		Товар.Номенклатура КАК ТоварНоменклатура,
		Товар.Код КАК ТоварКод,
		Товар.Количество КАК ТоварКоличество,
		Товар.Цена КАК ТоварЦена,
		Товар.Скидка КАК ТоварСкидка,
		Товар.Сумма КАК ТоварСумма
	) КАК ТоварыВЗаказе
ИЗ
	Документ.ЗаказПокупателя КАК ЗаказПокупателя
ГДЕ
	ЗаказПокупателя.Заказчик = &amp;Заказчик</query>
	</dataSet>
	<calculatedField>
		<dataPath>ПроцентСкидки</dataPath>
		<expression>(ТоварыВЗаказе.ТоварСкидка /ТоварыВЗаказе.ТоварСумма) * 100</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Процент скидки</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<totalField>
