&НаКлиенте
Процедура НачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Картинка1 = Элемент.Имя;	
КонецПроцедуры     
&НаКлиенте
Процедура ПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Картинка2 = Элемент.Имя;	
КонецПроцедуры
&НаКлиенте
Процедура ОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Часть1 = Элементы.Найти(Картинка1).Картинка;
	Часть2 = Элементы.Найти(Картинка2).Картинка;    
	Элементы.Найти(Картинка1).Картинка = Часть2;
	Элементы.Найти(Картинка2).Картинка = Часть1;
	Если Элементы.Часть1.Картинка = БиблиотекаКартинок.Картинка1 И
		Элементы.Часть2.Картинка = БиблиотекаКартинок.Картинка2 И
		Элементы.Часть3.Картинка = БиблиотекаКартинок.Картинка3 И
		Элементы.Часть4.Картинка = БиблиотекаКартинок.Картинка4 Тогда     
		КапчаПройдена = Истина; 
	Иначе
		КапчаПройдена = Ложь;
	КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура РасположитьКартинкиРандомно(ТекущееДействие = "")
	КапчаПройдена = Ложь;
	РандомноеЧисло = Новый ГенераторСлучайныхЧисел(); 
	
	ЕстьВсеКартинки = Ложь;
	
	Пока ЕстьВсеКартинки = Ложь Цикл
СтрокаРандомныхЧисел = Строка(РандомноеЧисло.СлучайноеЧисло(1, 5)) + Строка(РандомноеЧисло.СлучайноеЧисло(1, 5))
+ Строка(РандомноеЧисло.СлучайноеЧисло(1, 5)) + Строка(РандомноеЧисло.СлучайноеЧисло(1, 5));
		ЧислоКартинки1 = СтрНайти(СтрокаРандомныхЧисел, "1");
		ЧислоКартинки2 = СтрНайти(СтрокаРандомныхЧисел, "2");
		ЧислоКартинки3 = СтрНайти(СтрокаРандомныхЧисел, "3");
		ЧислоКартинки4 = СтрНайти(СтрокаРандомныхЧисел, "4");   
		Если ЧислоКартинки1 > 0 И ЧислоКартинки2 > 0 И ЧислоКартинки3 > 0 И ЧислоКартинки4 > 0 Тогда
			ЕстьВсеКартинки = Истина;
		КонецЕсли;   
		ЧислоКартинки1 = Лев(СтрокаРандомныхЧисел, 1);
		ЧислоКартинки2 = Сред(СтрокаРандомныхЧисел, 2, 1);
		ЧислоКартинки3 = Сред(СтрокаРандомныхЧисел, 3, 1);
		ЧислоКартинки4 = Прав(СтрокаРандомныхЧисел, 1);   	
		Если ТекущееДействие = "Начальное расположение" Тогда	
			Если Число(ЧислоКартинки1) = 1 И Число(ЧислоКартинки2) = 2 И Число(ЧислоКартинки3) = 3 И Число(ЧислоКартинки4) = 4 Тогда
				ЕстьВсеКартинки = Ложь;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;    
	Выполнить("Элементы.Часть1.Картинка = БиблиотекаКартинок.Картинка" + ЧислоКартинки1 + ";
	|Элементы.Часть2.Картинка = БиблиотекаКартинок.Картинка" + ЧислоКартинки2 + ";
	|Элементы.Часть3.Картинка = БиблиотекаКартинок.Картинка" + ЧислоКартинки3 + ";
	|Элементы.Часть4.Картинка = БиблиотекаКартинок.Картинка" + ЧислоКартинки4 + ";");	
КонецПроцедуры
&НаКлиенте
Процедура Далее(Команда)	
	Если Условия() Тогда    
			Пораметры = Новый Структура;
			Пораметры.Вставить("Роль", Роль);
			ОткрытьФорму("ОбщаяФорма.ФормаПользователя", Пораметры);  
		Иначе       
			РасположитьКартинкиРандомно();	
		КонецЕсли;
КонецПроцедуры
&НаСервере
Функция Условия()
	Попытка
		Справочник = Справочники.Пользователи.НайтиПоНаименованию(Логин).ПолучитьОбъект();
	Исключение
		Возврат Ложь;
	КонецПопытки;   
	Если Справочник.Активность = Ложь Тогда
		Сообщить("Вы заблокированы");
		Возврат Ложь; 
	КонецЕсли;
	Если Справочник.Пароль <> Пароль Тогда  
		Сообщить("Неверный пароль");
		УвеличитьПопытки(Справочник);
		Возврат Ложь;
	КонецЕсли;
	Если КапчаПройдена = Ложь Тогда     
		Сообщить("Капча не пройдена");
		УвеличитьПопытки(Справочник);
		Возврат Ложь;
	КонецЕсли;  
	Роль = Справочник.Роль;
	Возврат Истина;
КонецФункции 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РасположитьКартинкиРандомно("Начальное расположение");
КонецПроцедуры
&НаСервере
Процедура УвеличитьПопытки(Юзер)
	Юзер.Попытки = Юзер.Попытки + 1;
	Если (Юзер.Попытки > 3) Тогда
		Юзер.Активность = Ложь;
		Сообщить("Заблокирован");
	Иначе
		Сообщить("Осталось " + Строка((3 - Юзер.Попытки)));
	КонецЕсли;            
	Юзер.Записать();
КонецПроцедуры


