&НаСервере
Процедура ВыполнитьЗапрос(ИмяМетода, АдресРесурса, СтрокаТелаЗапроса)
	СерверИсточник = "localhost";
	Попытка
		HTTPСоединение = Новый HTTPСоединение(СерверИсточник,80,,,, 30);
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
		Результат = HTTPСоединение.ВызватьHTTPМетод(ИмяМетода, HTTPЗапрос);
		ТелоОтвета = Результат.ПолучитьТелоКакСтроку();
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		МассивЗаметок = ДанныеОтвета.Получить("value");           
		ВыбранныйОбъект = МассивЗаметок[0];
		ПолученныеДанные = ВыбранныйОбъект.Получить("title_user");
		СодержимоеЗаметки = ВыбранныйОбъект.Получить("Content");
	Исключение
		Сообщить("Ошибка запроса к OData: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
&НаКлиенте
Процедура ПолучитьДанные(Команда)
	АдресРесурса = "/bruh/odata/standard.odata/Catalog_Заметки?$select=id,title_user,Content,formatted_date&$format=json&$filter=id eq " + Индекс;
	ВыполнитьЗапрос("GET", АдресРесурса, "");
КонецПроцедуры

&НаСервере
Процедура OdataНаСервере()     
	Массив = Новый Массив();  
	Массив.Добавить(Метаданные.Справочники.Заметки);      
	УстановитьСоставСтандартногоИнтерфейсаOData(Массив);  	
КонецПроцедуры

&НаКлиенте
Процедура Odata(Команда)
	OdataНаСервере();
КонецПроцедуры    