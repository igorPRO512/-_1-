
&НаСервере
Процедура ЗаказчикиНаСервере(Строка)
	ЧтениеДжисон = Новый ЧтениеJSON;
	ЧтениеДжисон.УстановитьСтроку(Строка);
	Массив = ПрочитатьJson(ЧтениеДжисон);    
	ЧтениеДжисон.Закрыть();
	Для каждого Эл Из Массив Цикл
		Попытка
			Справочник = Справочники.Заказчики.НайтиПоКоду(Эл.id).ПолучитьОбъект(); 
			Сообщить("Заказчик с кодом: "+Эл.id + " уже существует"); 
		Исключение
			Справочник = Справочники.Заказчики.СоздатьЭлемент();
			Справочник.Код = Эл.id;
			Справочник.Наименование = Эл.name;
			Справочник.Инн = Эл.inn;
			Справочник.Адрес = Эл.addres;
			Справочник.Телефон = Эл.phone;
			Справочник.Тип = Эл.type;
			Справочник.Записать();
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заказчики(Команда)   
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выбери Джисон";
	Диалог.МножественныйВыбор = Ложь;
	Если Диалог.Выбрать() Тогда
		ТекДок = Новый ТекстовыйДокумент;
		ТекДок.Прочитать(Диалог.ПолноеИмяФайла, КодировкаТекста.UTF8);    
		Строка = ТекДок.ПолучитьТекст();
		ЗаказчикиНаСервере(Строка);
		Элементы.Список.Обновить();	
	КонецЕсли;
КонецПроцедуры
